<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.deepstack.ai.tool.mapper.AiToolMapper">

    <resultMap id="BaseResultMap" type="org.deepstack.ai.tool.model.entity.AiTool">
        <id property="id" column="id"/>
        <result property="toolCode" column="tool_code"/>
        <result property="toolName" column="tool_name"/>
        <result property="description" column="description"/>
        <result property="handlerBean" column="handler_bean"/>
        <result property="enabled" column="enabled"/>
        <result property="isDel" column="is_del"/>
        <result property="creatorId" column="creator_id"/>
        <result property="creator" column="creator"/>
        <result property="modifierId" column="modifier_id"/>
        <result property="modifier" column="modifier"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, tool_code, tool_name, description, handler_bean, enabled, is_del, creator_id, creator, modifier_id, modifier, create_time, update_time
    </sql>

</mapper>
