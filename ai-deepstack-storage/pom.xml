<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.deepstack.ai</groupId>
    <artifactId>ai-deepstack</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>ai-deepstack-storage</artifactId>
  <name>ai-deepstack-storage</name>
  <description>S3-compatible object storage adapter</description>
  <dependencies>
    <!--
      对象存储是能力适配器，不是契约：单独成模块，让不碰文件存储的模块
      （agent / chat / tool / card …）不必把整套 AWS SDK 带进编译期。
    -->
    <dependency>
      <groupId>org.deepstack.ai</groupId>
      <artifactId>ai-deepstack-kernel</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>2.20.162</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
