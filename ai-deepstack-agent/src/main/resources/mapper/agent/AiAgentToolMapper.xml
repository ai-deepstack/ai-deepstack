<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.deepstack.ai.agent.mapper.AiAgentToolMapper">

    <resultMap id="BaseResultMap" type="org.deepstack.ai.agent.model.entity.AiAgentTool">
        <id property="id" column="id"/>
        <result property="agentId" column="agent_id"/>
        <result property="toolId" column="tool_id"/>
        <result property="priority" column="priority"/>
        <result property="enabled" column="enabled"/>
        <result property="isDel" column="is_del"/>
        <result property="creatorId" column="creator_id"/>
        <result property="creator" column="creator"/>
        <result property="modifierId" column="modifier_id"/>
        <result property="modifier" column="modifier"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, agent_id, tool_id, priority, enabled, is_del, creator_id, creator, modifier_id, modifier, create_time, update_time
    </sql>

    <delete id="deleteByAgentId">
        DELETE FROM ai_agent_tool
        WHERE agent_id = #{agentId}
    </delete>

</mapper>
